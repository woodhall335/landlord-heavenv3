{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && pnpm install --no-frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "crons": [
    {
      "path": "/api/cron/legal-change-check?key=$CRON_SECRET",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/seo/cron/daily?key=$CRON_SECRET",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/stale-cases-cleanup?key=$CRON_SECRET",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/recovery-orchestrator?key=$CRON_SECRET",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/rent-checker-followups?key=$CRON_SECRET",
      "schedule": "37 9 * * *"
    },
    {
      "path": "/api/cron/compliance-check?key=$CRON_SECRET",
      "schedule": "0 8 * * *"
    }
  ]
}
